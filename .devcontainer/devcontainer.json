{
  "name": "agentic-project-management-modme",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "20gb"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.apm,target=/home/vscode/.apm,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "OTEL_ENABLED": "true",
    "OTEL_EXPORTER_TYPE": "sqlite",
    "OTEL_SQLITE_DB_PATH": "/home/vscode/.apm/traces.db",
    "OTEL_SQLITE_MAX_SPANS": "50000",
    "OTEL_SQLITE_MAX_SIZE_MB": "100",
    "OTEL_SQLITE_RETENTION_DAYS": "7"
  },
  "customizations": {
    "devpod": {
      "featureDownloadHTTPHeaders": {
        "AUTHORIZATION": "${env:GITHUB_TOKEN}"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "ms-vscode-remote.remote-containers",
        "modelcontextprotocol.mcp"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "postCreateCommand": "npm ci",
  "postStartCommand": "node --version && npm --version"
}
