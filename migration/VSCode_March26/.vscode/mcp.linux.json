{
    "_comment": "Linux/WSL version of mcp.json — copy or symlink this to .vscode/mcp.json when working in WSL.",
    "mcpServers": {
            "type": "stdio",
            "env": {
                "CONTEXTSTREAM_API_KEY": "${env:CONTEXTSTREAM_API_KEY}"
            }
        },
        "n8n-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "n8n-mcp"
            ],
            "env": {
                "MCP_MODE": "stdio",
                "N8N_MODE": "true",
                "LOG_LEVEL": "error",
                "DISABLE_CONSOLE_OUTPUT": "true",
                "N8N_API_URL": "${env:N8N_API_URL}",
                "N8N_API_KEY": "${env:N8N_API_KEY}"
            }
        },
        "desktop-commander": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "@wonderwhy-er/desktop-commander"
            ],
            "disabled": false
        }
    },
    "servers": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "--prefer-online",
                "-y",
            ],
            "env": {
                "CONTEXTSTREAM_API_KEY": "${env:CONTEXTSTREAM_API_KEY}",
                "CONTEXTSTREAM_CONTEXT_PACK": "true"
            }
        }
    }
}