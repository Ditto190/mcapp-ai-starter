{
  "mcpServers": {
      "type": "stdio",
      "env": {
        "CONTEXTSTREAM_API_KEY": "${env:CONTEXTSTREAM_API_KEY}"
      }
    },
    "n8n-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "N8N_MODE": "true",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": "${env:N8N_API_URL}",
        "N8N_API_KEY": "${env:N8N_API_KEY}"
      }
    },
    "desktop-commander": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@wonderwhy-er/desktop-commander"
      ],
      "disabled": false
    }
  },
  "servers": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "--prefer-online",
        "-y",
      ],
      "env": {
        "CONTEXTSTREAM_API_KEY": "cbiq_T20ryJIZ9tAVg2Gd_-wkmVYpXn7DGdWQeihi1YMcAdU",
        "CONTEXTSTREAM_CONTEXT_PACK": "true"
      }
    }
  }
}
