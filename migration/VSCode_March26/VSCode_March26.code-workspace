{
  "folders": [
    {
      "name": "VSCode_March26",
      "path": ".",
    },
  ],
  "settings": {
    // -----------------------------------------------------------------
    // Python — point to the WSL venv
    // -----------------------------------------------------------------
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    // -----------------------------------------------------------------
    // Editor
    // -----------------------------------------------------------------
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
      },
    },
    "[yaml]": {
      "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    // -----------------------------------------------------------------
    // Terminal — force bash inside WSL
    // -----------------------------------------------------------------
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.profiles.linux": {
      "bash": {
        "path": "/bin/bash",
        "icon": "terminal-bash",
      },
    },
    // -----------------------------------------------------------------
    // Files
    // -----------------------------------------------------------------
    "files.eol": "\n",
    "files.encoding": "utf8",
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/*.pyc": true,
      "**/node_modules": true,
      "**/.venv": true,
      "**/.git": false,
    },
    // -----------------------------------------------------------------
    // Pylance / Pyright
    // -----------------------------------------------------------------
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    // -----------------------------------------------------------------
    // Git
    // -----------------------------------------------------------------
    "git.defaultCloneDirectory": "~/workspaces",
    // -----------------------------------------------------------------
    // Chat / Copilot
    // -----------------------------------------------------------------
    "chat.useClaudeHooks": true,
    "chat.useCustomAgentHooks": true,
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-pyright.pyright",
      "ms-python.debugpy",
      "charliermarsh.ruff",
      "donjayamanne.python-environment-manager",
      "ms-python.vscode-python-envs",
      "ms-toolsai.jupyter",
      "ms-toolsai.jupyter-keymap",
      "ms-toolsai.jupyter-renderers",
      "eamodio.gitlens",
      "mhutchie.git-graph",
      "donjayamanne.githistory",
      "github.vscode-pull-request-github",
      "github.vscode-github-actions",
      "github.copilot-chat",
      "anthropic.claude-code",
      "timheuer.awesome-copilot",
      "digitarald.agent-memory",
      "ms-vscode-remote.remote-wsl",
      "ms-vscode-remote.remote-containers",
      "ms-azuretools.vscode-docker",
      "mongodb.mongodb-vscode",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "foxundermoon.shell-format",
      "redhat.vscode-yaml",
      "tamasfe.even-better-toml",
      "yzhang.markdown-all-in-one",
      "humao.rest-client",
      "mechatroner.rainbow-csv",
      "pkief.material-icon-theme",
      "amadeusitgroup.prompt-registry",
      "pimzino.spec-workflow-mcp",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Python: Current File",
        "type": "debugpy",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal",
        "justMyCode": false,
      },
      {
        "name": "Python: Agents",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/agents/${input:agentFile}",
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}",
      },
    ],
    "inputs": [
      {
        "id": "agentFile",
        "type": "pickString",
        "description": "Choose agent to run",
        "options": [
          "sample_agent.py",
          "smoke_test.py",
          "trace_database.py",
          "discover_apis.py",
          "document_manager.py",
        ],
      },
    ],
  },
}
